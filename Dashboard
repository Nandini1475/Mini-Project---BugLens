<!DOCTYPE html>
<html>
<head>
<title>BugLens</title>

<!-- ✅ remove favicon 404 -->
<link rel="icon" href="data:,">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">

<style>
body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(-45deg, #a18cd1, #fbc2eb, #fad0c4, #ff9a9e);
    background-size: 400% 400%;
    animation: gradientBG 25s ease infinite;
}

@keyframes gradientBG {
    0% { background-position: 0% 50% }
    50% { background-position: 100% 50% }
    100% { background-position: 0% 50% }
}

.container {
    width: 90%;
    margin: auto;
    padding: 20px;
}

h1 {
    text-align: center;
    font-size: 45px;
    background: linear-gradient(90deg,#222,#000);
    -webkit-background-clip: text;
    color: transparent;
}

.card {
    background: rgba(255,255,255,0.25);
    padding: 20px;
    border-radius: 20px;
    margin-bottom: 20px;
}

.input-row {
    display: flex;
    justify-content: center;
    gap: 10px;
}

input {
    width: 60%;
    padding: 12px;
    border-radius: 10px;
    border: none;
}

button {
    padding: 10px 18px;
    border-radius: 10px;
    border: none;
    background: #ff7eb3;
    color: white;
    cursor: pointer;
}

.stats {
    display: flex;
    gap: 10px;
}

.stat-box {
    flex: 1;
    background: rgba(255,255,255,0.4);
    padding: 15px;
    border-radius: 10px;
    text-align: center;
}

.chart-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

canvas {
    width: 420px !important;
    height: 300px !important;
}

.list {
    max-height: 280px;
    overflow-y: auto;
}

.issue {
    background: rgba(255,255,255,0.4);
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 10px;
}

.filters {
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
}

.loader {
    display:none;
    text-align:center;
}

.loader div{
    width:40px;
    height:40px;
    border:5px solid white;
    border-top:5px solid #ff7eb3;
    border-radius:50%;
    animation:spin 1s linear infinite;
    margin:auto;
}

@keyframes spin{
    100%{transform:rotate(360deg)}
}
</style>
</head>

<body>

<div class="container">

<h1>BugLens</h1>

<div class="card input-row">
<input id="repo" placeholder="Paste repo link">
<button onclick="fetchIssues()">Analyze</button>
</div>

<div id="loader" class="loader"><div></div></div>

<div class="stats">
<div class="stat-box">Total<br><span id="total">0</span></div>
<div class="stat-box">High<br><span id="high">0</span></div>
<div class="stat-box">Medium<br><span id="medium">0</span></div>
<div class="stat-box">Low<br><span id="low">0</span></div>
</div>

<div class="card chart-row">
<div>
<select id="chartType">
<option value="pie">Pie</option>
<option value="bar">Bar</option>
<option value="line">Line</option>
<option value="radar">Radar</option>
<option value="polarArea">Polar</option>
<option value="bubble">Bubble</option>
<option value="scatter">Scatter</option>
</select>
<button onclick="loadChart()">Show</button>
</div>

<canvas id="chart"></canvas>
</div>

<div class="card">

<div class="filters">
<button onclick="filter('all')">All</button>
<button onclick="filter('High')">High</button>
<button onclick="filter('Medium')">Medium</button>
<button onclick="filter('Low')">Low</button>
<button onclick="filter('fixed')">Fixed</button>
<button onclick="filter('repeated')">Repeated</button>
</div>

<div id="list" class="list"></div>

</div>

</div>

<script>

let allData = [];
let chart;

// 🔴 MAIN FUNCTION
function fetchIssues(){
    const loader = document.getElementById("loader");
    const repoInput = document.getElementById("repo").value;

    loader.style.display = "block";

    if(!repoInput){
        alert("Enter repo link");
        loader.style.display = "none";
        return;
    }

    fetch("/fetch", {
        method:"POST",
        headers:{"Content-Type":"application/x-www-form-urlencoded"},
        body:"repo=" + encodeURIComponent(repoInput)
    })
    .then(res => res.json())
    .then(() => {
        loadChart();  // load only after backend finishes
    })
    .catch(err => {
        console.error(err);
        loader.style.display = "none";
    });
}

// 🔴 LOAD DATA
function loadChart(){
    fetch("/data")
    .then(res => res.json())
    .then(data => {

        console.log("DATA:", data);

        document.getElementById("loader").style.display="none";

        allData = data.all || [];

        document.getElementById("total").innerText = allData.length;

        let risk = data.summary_risk || {High:0, Medium:0, Low:0};

        document.getElementById("high").innerText = risk.High;
        document.getElementById("medium").innerText = risk.Medium;
        document.getElementById("low").innerText = risk.Low;

        createChart(data);
        showList(allData);
    });
}

// 🔴 CHART
function createChart(data){

    const ctx = document.getElementById("chart").getContext("2d");
    if(chart) chart.destroy();

    const type = document.getElementById("chartType").value;

    let bugTypes = data.summary_bug_type;

    let labels = [
       "UI Bug",
       "Functional Bug",
       "Performance Bug",
       "Security Bug",
       "Compatibility Bug",
       "Network Bug",
       "Database Bug",
       "Memory Bug",
       "API Bug",
       "Logic Bug"
    ];

let values = labels.map(label => bugTypes[label] || 0);
    if(type === "bubble" || type === "scatter"){
        let bubbleData = values.map((v,i)=>({x:i+1,y:v,r:10}));

        chart = new Chart(ctx,{
            type:type,
            data:{
                datasets:[{
                    label:"Bugs",
                    data:bubbleData
                }]
            }
        });
    }
    else{
        chart = new Chart(ctx,{
            type:type,
            data:{
                labels: labels,
                datasets:[{
                    label:"Bugs",
                    data: values
                }]
            },
            options:{
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    }
}

// 🔴 LIST
function showList(list){

    if(!list || list.length === 0){
        document.getElementById("list").innerHTML = "No issues found";
        return;
    }

    let html = "";

    list.forEach(i=>{
        html += `
        <div class="issue">
            <b>${i.title}</b><br>
            ${i.bug_type} | ${i.risk} (${i.confidence || 0}%)
        </div>`;
    });

    document.getElementById("list").innerHTML = html;
}

// 🔴 FILTER
function filter(type){

    if(type==="all") return showList(allData);

    if(type==="fixed")
        return showList(allData.filter(i=>i.state==="closed"));

    if(type==="repeated"){
        let seen={}, rep=[];
        allData.forEach(i=>{
            if(seen[i.title]) rep.push(i);
            else seen[i.title]=1;
        });
        return showList(rep);
    }

    showList(allData.filter(i=>i.risk===type));
}

</script>

</body>
</html>
